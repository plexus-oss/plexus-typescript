{
  "name": "plexus-typescript",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for Plexus telemetry — send metrics and events from Node services, workers, and (via a server proxy) the browser.",
  "license": "Apache-2.0",
  "homepage": "https://plexus.company",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plexus-oss/plexus-typescript.git"
  },
  "bugs": "https://github.com/plexus-oss/plexus-typescript/issues",
  "keywords": [
    "plexus",
    "telemetry",
    "observability",
    "metrics",
    "iot",
    "analytics"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && publint"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "publint": "^0.2.8",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
